# --- Секреты -----------------------------------------------------------
# Токены сторонних сервисов (Discogs и что появится дальше). Папка под
# git, и один `git add -A` отправил бы токен в историю навсегда — а из
# истории его уже не убрать, только перевыпускать.
darave_secrets.json
*secrets.json

# --- Сборка установщика -------------------------------------------------
# build.ps1 кладёт сюда окружение сборки, скачанный ffmpeg, распакованный
# Python для пакета слоёв и готовые exe. Всё это восстанавливается одной
# командой и весит гигабайты — в репозиторий не идёт.
.build-venv/
dist/
installer/
build/ffmpeg/
build/stems-python/
*.spec.bak

# --- данные и личное, чему в репозитории не место ---------------------
#
# Разметка стемов (stems/*/meta.json) лежала в git 93 файлами. Это ДАННЫЕ
# анализа конкретной библиотеки, а не код: у каждого своя, и коммитить их
# значит возить чужие карты вокала в чужих клонах. С переездом папки в
# %LOCALAPPDATA% они ещё и превратились в 93 «удалено» на каждом статусе.
stems/

# Кто эта машина и под каким аккаунтом она активирована. Личное, и в
# общий репозиторий попадать не должно ни при каких обстоятельствах.
darave_account.json
darave_device.json

# Мусор от самопроверки и от рабочих сессий.
проба-записи/
Claude outputs/
