# Служебные файлы API наружу не отдаём. _config.php содержит пароль базы,
# и один неверный чих в настройках PHP превращает его в текстовый файл,
# который отдаётся кому угодно.
<FilesMatch "^_">
  Require all denied
</FilesMatch>
<Files "*.sample.php">
  Require all denied
</Files>
Options -Indexes
